{
  "expo": {
    "name": "DailyBoard",
    "slug": "techomato-dailyboard",
    "scheme": "dailyboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141417",
    "ios": {
      "bundleIdentifier": "com.techomato.dailyboard",
      "supportsTablet": false
    },
    "android": {
      "package": "com.techomato.dailyboard",
      "adaptiveIcon": {
        "backgroundColor": "#141417",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.USE_FULL_SCREEN_INTENT"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#141417"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withLockScreen",
      ["expo-notifications", { "sounds": ["./assets/sounds/alarm.wav", "./assets/sounds/reminder.wav"] }],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "216f1ca2-a52e-49db-b9c9-c1140a18f411"
      }
    },
    "owner": "techomato"
  }
}
