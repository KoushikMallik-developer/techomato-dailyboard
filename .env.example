# Copy to .env and fill from Firebase console > Project settings > Your apps > Web app.
# These are public identifiers, not secrets. Leave empty to keep the app on-device only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Public page for your privacy policy (docs/privacy-policy.md, published somewhere). Shown as a link on the sign-in screen.
EXPO_PUBLIC_PRIVACY_URL=
